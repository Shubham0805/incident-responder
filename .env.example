# --- TrueForge harness (run separately: `npx @truefoundry/trueforge@latest`) ---
# This is the HOST-side URL, used by scripts/register.py (which always runs
# directly on your machine, never in a container) -- leave this as
# localhost. The `backend` Docker container reaches TrueForge a different
# way (via host.docker.internal, wired in docker-compose.yml) and does NOT
# read this variable -- only override that path with TRUEFORGE_DOCKER_URL
# below, and only if your setup is non-standard (e.g. TrueForge running
# somewhere other than your own machine).
TRUEFORGE_BASE_URL=http://localhost:8790
# The `backend` Docker container reaches TrueForge through
# scripts/host_proxy.py (run that in its own terminal, alongside
# `npx trueforge`) via the Docker bridge gateway IP, auto-discovered at
# runtime -- NOT through this variable, and NOT through host.docker.internal
# (unreliable on Docker Desktop -- see backend/trueforge_client.py). Only
# set TRUEFORGE_DOCKER_URL below if you need to override that entirely.
# TRUEFORGE_DOCKER_URL=http://host.docker.internal:8790
# Port scripts/host_proxy.py listens on (must match TRUEFORGE_PROXY_PORT
# used when you run that script, if you changed it from the default).

# Only needed if you run TrueForge in hosted/Docker mode with auth enabled.
TRUEFORGE_API_KEY=

# --- This project's own local services ---
DEMO_APP_PORT=8081
MCP_SERVER_PORT=8082
BACKEND_PORT=8083
DASHBOARD_PORT=8501

DEMO_APP_URL=http://localhost:8081
MCP_SERVER_URL=http://localhost:8082/mcp
BACKEND_URL=http://localhost:8083

# Error-rate threshold (%) that the mock telemetry watcher treats as "incident"
ERROR_RATE_THRESHOLD=85

# Name TrueForge will know this agent by (registered by scripts/register.py)
TRUEFORGE_AGENT_NAME=incident-responder
TRUEFORGE_MCP_SERVER_NAME=sre-tools
TRUEFORGE_SKILL_NAME=sre-playbook
TRUEFORGE_SKILL_REF=main

# One LLM provider must be configured *inside TrueForge's own Settings UI*
# (http://localhost:8790 -> Settings -> Models). This repo never sees your
# LLM or Daytona API keys directly.
#
# TRUEFORGE_MODEL must be the exact "provider/model" string TrueForge
# reports for the model you configured -- NOT the name shown in the
# Settings UI, and NOT the `model_id` field. Get the real string with:
#   curl -s http://localhost:8790/api/v1/models | python3 -m json.tool
# and copy the `name` field, e.g.:
#   openai/gpt-5.2
#   google-gemini/gemini-3-6-flash
# Sending the wrong format fails with a confusing "provider not configured"
# 422, not an obvious "bad format" error, so don't skip this step.
TRUEFORGE_MODEL=

# Needed for scripts/register.py to register the skill (git-backed --
# needs a real pushed repo, not a local-only folder). Push this repo to
# GitHub first, then set this to its URL.
GITHUB_REPO_URL=https://github.com/<you>/<repo>
